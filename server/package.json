{
  "name": "tabctl-server",
  "version": "1.0.0",
  "description": "tabctl local JSON server — kubectl for your browser tabs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "TABCTL_DB=$(pwd)/tabctl.db node dist/server.js",
    "dev": "TABCTL_DB=$(pwd)/tabctl.db ts-node server.ts",
    "watch": "nodemon --exec ts-node server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
